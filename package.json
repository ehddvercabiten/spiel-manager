{
  "name": "region-spiel-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf node_modules package-lock.json",
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/index.js",
    "hash-pin": "node scripts/hash-pin.mjs",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name spiel-manager --branch main",
    "cloudflare:login": "wrangler login",
    "cloudflare:whoami": "wrangler whoami",
    "db:migrate:production": "wrangler d1 migrations apply spiel-manager-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply spiel-manager-db --local",
    "db:import:prepare": "node scripts/import-excel-to-d1.mjs",
    "deploy": "bash scripts/deploy-cloudflare.sh",
    "deploy:production": "bash scripts/deploy-cloudflare.sh",
    "dev:worker": "wrangler dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "session-file-store": "^1.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/session-file-store": "^1.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "rimraf": "^6.1.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.158.0"
  }
}
