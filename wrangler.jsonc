{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spiel-manager",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"r2_buckets": [
		{
			"bucket_name": "spiel-manager-payment-receipts",
			"binding": "RECEIPTS_BUCKET",
			"remote": false
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "spiel-manager-db",
			"database_id": "",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"MAYA_ENV": "sandbox",
		"APP_BASE_URL": "https://spiel-manager.veihcah.workers.dev/",
		"PAYMENT_QR_URL": "/payment/gcash-qr-placeholder.png"
	}
}